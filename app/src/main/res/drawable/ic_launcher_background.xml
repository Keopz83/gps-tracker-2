<?xml version="1.0" encoding="utf-8"?>
<!-- REQ-10: diagonal red → purple → blue gradient, same as the app background; spans the visible safe zone so the mask keeps both ends -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="21"
                android:startY="21"
                android:endX="87"
                android:endY="87">
                <item android:offset="0" android:color="@color/gradient_red" />
                <item android:offset="0.5" android:color="@color/gradient_purple" />
                <item android:offset="1" android:color="@color/gradient_blue" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
